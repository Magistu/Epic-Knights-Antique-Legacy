# Example properties for upgrading to Minecraft 1.21.1
# Copy this over gradle.properties when you are ready to switch.

# Done to increase the memory available to gradle.
org.gradle.jvmargs=-Xmx4G

enabled_platforms=fabric,forge

minecraft_version=1.21.1
mod_version=1.0
maven_group=io.github.magistu
archives_base_name=[1.21.x]-Epic-Knights-Antique-Legacy

# Dependencies (1.21.1-compatible)
cloth_config_version=16.0.143
architectury_version=14.0.4
fabric_loader_version=0.17.2
fabric_api_version=0.116.6+1.21.1
forge_version=52.1.0

# NOTE: The following remains a placeholder until the upstream publishes a 1.21.1 build.
# If you build the Epic Knights base mod locally for 1.21.1 and publish to mavenLocal,
# keep this value aligned with that build's published version.
epic_knights_version=8.6
