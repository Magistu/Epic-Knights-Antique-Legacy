{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "icon": "icon.png",
  "authors": ["minucius", "Magistu"],
  "contributors": ["Borki", "StaxiHD", "Plaguedoctor", "Superamogus", "Santusio"],
  "contact": {
    "homepage": "${mod_page_url}",
    "issues": "${mod_issues_url}",
    "sources": "${mod_git_url}",
    "discord": "${mod_discord_url}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.magistuarmory.antiquelegacy.fabric.EpicKnightsAntiqueLegacyFabric"
    ]
  },
  "depends": {
    "fabric": "*",
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_min_version} <${minecraft_max_version}",
    "magistuarmory": ">=10.8"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${mod_discord_url}"
      }
    }
  }
}